{
  "name": "tierforge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first tier-list builder and importer",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "serve": "node src/server.js",
    "start": "npm run serve",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/importer.js && node --check app.js && node --check scripts/build.js"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=20"
  }
}
