{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tierforge",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-05",
  "build": {
    "command": "node scripts/build.js"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/image"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
